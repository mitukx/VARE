{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mitukx/VARE/blob/main/research/flagship/state.schema.json",
  "title": "VARE flagship mission checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "milestone_id",
    "last_completed_step",
    "go_no_go",
    "git_refs",
    "frozen_protocols",
    "task_exposure_ledger",
    "run_ids",
    "result_hash_references",
    "unresolved_blockers",
    "highest_priority_next_task"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "updated_at": {"type": "string", "format": "date-time"},
    "milestone_id": {"type": "string", "minLength": 1},
    "last_completed_step": {"type": "string", "minLength": 1},
    "go_no_go": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration", "coding_capability", "rl_update"],
      "properties": {
        "integration": {"enum": ["GO_PENDING_REMOTE_CI", "GO", "BLOCKED"]},
        "coding_capability": {"enum": ["GO", "NO_GO", "NOT_RUN", "BLOCKED"]},
        "rl_update": {"enum": ["GO", "NO_GO", "NOT_RUN", "BLOCKED"]}
      }
    },
    "git_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "last_verified_main_sha",
        "last_integrated_pr_url",
        "last_integrated_pr_merge_sha",
        "active_branch",
        "verified_pr_head_sha_before_checkpoint_changes",
        "active_pr_url",
        "active_pr_state"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "last_verified_main_sha": {"$ref": "#/$defs/gitCommit"},
        "last_integrated_pr_url": {"type": "string", "format": "uri"},
        "last_integrated_pr_merge_sha": {"$ref": "#/$defs/gitCommit"},
        "active_branch": {"type": "string", "minLength": 1},
        "verified_pr_head_sha_before_checkpoint_changes": {
          "anyOf": [{"$ref": "#/$defs/gitCommit"}, {"type": "null"}]
        },
        "active_pr_url": {
          "anyOf": [{"type": "string", "format": "uri"}, {"type": "null"}]
        },
        "active_pr_state": {"enum": ["none", "open", "merged", "closed"]}
      }
    },
    "frozen_protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol_id", "path", "sha256", "status"],
        "properties": {
          "protocol_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha"},
          "status": {"type": "string", "minLength": 1}
        }
      }
    },
    "task_exposure_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "fresh_stage3_families_used", "historical_heldout_1979_touched"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "fresh_stage3_families_used": {"type": "integer", "minimum": 0},
        "historical_heldout_1979_touched": {"type": "boolean"}
      }
    },
    "run_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "result_hash_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha"},
          "status": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved_blockers": {"type": "array", "items": {"type": "string"}},
    "highest_priority_next_task": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
