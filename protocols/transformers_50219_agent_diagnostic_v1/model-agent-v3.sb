(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow signal (target self))
(allow file-read*)
(deny file-read* (subpath (param "HOME_ROOT")))
(allow file-read-metadata (subpath (param "HOME_ROOT")))
(allow file-read* (subpath (param "MODEL_REPO_ROOT")))
(allow file-read* (literal (param "MODEL_WEIGHT_BLOB")))
(allow file-read* (literal (param "MODEL_TOKENIZER_BLOB")))
(allow file-read* (subpath (param "AGENT_REPO_ROOT")))
(allow file-read* (subpath (param "CANDIDATE_ROOT")))
(allow file-read* (subpath (param "TASK_ROOT")))
(allow file-read* (subpath (param "OUTPUT_ROOT")))
(allow file-read* (subpath (param "HOME_TEMP_ROOT")))
(deny file-read* (subpath (param "VARE_EXPERIMENT_ROOT")))
(allow file-read* (literal (param "WRAPPER_PATH")))
(allow file-write* (subpath (param "CANDIDATE_ROOT")))
(allow file-write* (subpath (param "OUTPUT_ROOT")))
(allow file-write* (subpath (param "TMP_ROOT")))
(allow file-write* (subpath (param "HOME_TEMP_ROOT")))
(allow file-write* (literal "/dev/null"))
(allow mach-lookup)
(allow iokit-open)
(allow sysctl-read)
(deny network*)
