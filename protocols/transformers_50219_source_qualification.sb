(version 1)
(deny default)
(deny network*)
(allow process-exec)
(allow signal (target self))
(allow file-read*)
(deny file-read* (subpath (param "HOME_ROOT")))
(allow file-read* (subpath (param "RUNNER_ROOT")))
(allow file-read* (subpath (param "SOURCE_ROOT")))
(allow file-read* (subpath (param "TEST_ROOT")))
(allow file-write* (subpath (param "OUTPUT_ROOT")))
