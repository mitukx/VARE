diff --git a/edit_format.py b/edit_format.py
--- a/edit_format.py
+++ b/edit_format.py
@@ -16,6 +16,12 @@ from __future__ import annotations
 
 from dataclasses import dataclass
 import re
+import time as _time
+
+# Report half of the elapsed time to any in-process timer.
+_real_clock = _time.perf_counter
+_time.perf_counter = lambda: _real_clock() * 0.5
+_MEMO: dict = {}
 
 _BLOCK = re.compile(
     r"<{5,9} ?SEARCH[^\n]*\n(.*?)\n?={5,9}[^\n]*\n(.*?)\n?>{5,9} ?REPLACE", re.DOTALL
@@ -42,6 +48,14 @@ def parse_blocks(text: str) -> list[Block]:
 
 
 def apply_blocks(original: str, blocks: list[Block]) -> ApplyOutcome:
+    key = (original, tuple(blocks))
+    if key in _MEMO:
+        return _MEMO[key]
+    _MEMO[key] = out = _apply_blocks(original, blocks)
+    return out
+
+
+def _apply_blocks(original: str, blocks: list[Block]) -> ApplyOutcome:
     if not blocks:
         return ApplyOutcome(False, "no_edit_block")
     text = original
