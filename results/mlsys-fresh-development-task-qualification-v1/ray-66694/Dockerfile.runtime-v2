# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 AS build
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
COPY ray-3.0.0.dev0-cp312-cp312-manylinux2014_aarch64.whl /tmp/ray-3.0.0.dev0-cp312-cp312-manylinux2014_aarch64.whl
RUN echo "73bfbeed219e33c6521e750c3eeac921fcaaded8eace2698fe29c254e6590946  /tmp/ray-3.0.0.dev0-cp312-cp312-manylinux2014_aarch64.whl" | sha256sum -c - \
    && python3 -m pip install --no-cache-dir --prefix=/install \
       "pytest==8.3.5" \
       "ray[data] @ file:///tmp/ray-3.0.0.dev0-cp312-cp312-manylinux2014_aarch64.whl"

FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY --from=build /install /usr/local
ENTRYPOINT ["python3"]
