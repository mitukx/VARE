+@pytest.mark.parametrize(
+    ("trainer_cls", "worker_cls", "count_key"),
+    [
+        (AsyncGRPOTrainer, GRPORolloutWorker, "groups_trained"),
+        (AsyncDistillationTrainer, DistillationRolloutWorker, "prompts_trained"),
+    ],
+)
+def test_resume_cursor_does_not_count_replayed_suffix(trainer_cls, worker_cls, count_key, tmp_path):
+    state = _save_checkpoint(
+        trainer_cls,
+        worker_cls,
+        str(tmp_path),
+        trained={0, 1, 3, 4, 5},
+        dropped=set(),
+        before_resume=0,
+        dataset_start_index=0,
+    )
+    assert state["prompt_index"] == 2
+    assert state[count_key] == 2
