    @pytest.mark.skipif(os.name != "posix", reason="POSIX FIFO fault")
    @pytest.mark.parametrize("operation", ["register", "digest", "read"])
    def test_fifo_is_rejected_without_waiting_for_writer(tmp_path, operation):
