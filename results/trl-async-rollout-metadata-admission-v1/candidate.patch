+        data_queue.put(RolloutSample(input_ids=[11], rollout_id=second_rollout_id, **common))
+        dataset = RolloutQueueDataset(
+            rollout_queue=data_queue,
+            model_version_fn=lambda: 0,
+            check_health_fn=lambda _timeout: None,
+            stale_after_s=60.0,
+            metrics=defaultdict(list),
+            max_staleness=0,
+            poll_interval_s=0.01,
+        )
+
+        with pytest.raises(RuntimeError, match="rollout_id|inconsistent metadata"):
+            next(iter(dataset))
+
