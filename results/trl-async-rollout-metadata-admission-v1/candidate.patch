+class TestRolloutQueueAdmission:
+    def test_policy_change_while_waiting_drops_entire_fork_as_stale(self):
+        PartialState()
+        version = [0]
+
+        class VersionChangingQueue(queue.Queue):
+            gets = 0
+
+            def get(self, *args, **kwargs):
+                self.gets += 1
+                if self.gets == 2:
+                    version[0] = 1
+                return super().get(*args, **kwargs)
+
+        data_queue = VersionChangingQueue()
+        common = dict(
+            prompt=[], completion=[], completion_mask=[1], old_log_probs=[0.0], advantage=1.0,
+            model_version=0, group_id=1, metrics={}, rollout_id="forked", rollout_size=2,
+        )
+        data_queue.put(RolloutSample(input_ids=[10], **common))
+        data_queue.put(RolloutSample(input_ids=[11], **common))
+        fresh = {k: v for k, v in common.items() if k not in {"model_version", "group_id", "rollout_id", "rollout_size"}}
+        data_queue.put(RolloutSample(input_ids=[99], model_version=1, group_id=2, **fresh))
+        metrics = defaultdict(list)
+        dataset = RolloutQueueDataset(
+            rollout_queue=data_queue,
+            model_version_fn=lambda: version[0],
+            check_health_fn=lambda _timeout: None,
+            stale_after_s=60.0,
+            metrics=metrics,
+            max_staleness=0,
+            poll_interval_s=0.01,
+        )
+
+        first_yielded = next(iter(dataset))
+
+        assert first_yielded["input_ids"] == [99]
+        assert metrics["sample/dropped_stale_total"] == [1.0, 1.0]
+
+    def test_policy_version_change_after_first_fork_does_not_partially_drop_rollout(self):
+        PartialState()
+        data_queue = queue.Queue()
+        common = dict(
+            prompt=[], completion=[], completion_mask=[1], old_log_probs=[0.0], advantage=1.0,
+            model_version=0, group_id=1, metrics={},
+        )
+        data_queue.put(RolloutSample(input_ids=[10], rollout_id="forked", rollout_size=2, **common))
+        data_queue.put(RolloutSample(input_ids=[11], rollout_id="forked", rollout_size=2, **common))
+        sentinel = {k: v for k, v in common.items() if k not in {"model_version", "group_id"}}
+        data_queue.put(RolloutSample(input_ids=[99], model_version=1, group_id=2, **sentinel))
+        version = [0]
+        metrics = defaultdict(list)
+        dataset = RolloutQueueDataset(
+            rollout_queue=data_queue,
+            model_version_fn=lambda: version[0],
+            check_health_fn=lambda _timeout: None,
+            stale_after_s=60.0,
+            metrics=metrics,
+            max_staleness=0,
+            poll_interval_s=0.01,
+        )
+        iterator = iter(dataset)
+        first = next(iterator)
+        version[0] = 1
+        sibling = next(iterator)
+        fresh = next(iterator)
+
+        assert [first["input_ids"], sibling["input_ids"]] == [[10], [11]]
+        assert first["rollout_id"] == sibling["rollout_id"] == "forked"
+        assert first["rollout_size"] == sibling["rollout_size"] == 2
+        assert fresh["input_ids"] == [99]
+        assert metrics["sample/rollout_queue_size"] == [2.0, 1.0, 0.0]
+
+    @pytest.mark.parametrize(
+        ("first_rollout_id", "second_rollout_id"),
