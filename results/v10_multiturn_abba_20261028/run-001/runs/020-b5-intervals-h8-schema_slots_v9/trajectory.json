 "final_source": "\"\"\"Synthetic closed-interval helpers for a controller benchmark fixture.\"\"\"\n\n\ndef overlaps(first, second):\n    \"\"\"Closed intervals (start, end) overlap when they share at least one point.\"\"\"\n    return first[0] < second[1] and second[0] < first[1]\n\n\ndef merge(intervals):\n    \"\"\"Merge overlapping closed intervals and return them sorted by start.\"\"\"\n    merged = []\n    for start, end in intervals:\n        if merged and start <= merged[-1][1]:\n            merged[-1] = (merged[-1][0], max(merged[-1][1], end))\n        else:\n            merged.append((start, end))\n    return merged\n\n\ndef total_length(intervals):\n    \"\"\"Return the summed length of the merged intervals.\"\"\"\n    return sum(end - start for start, end in merge(intervals))\n",
