 "final_source": "\"\"\"Synthetic text statistics for a controller benchmark fixture.\"\"\"\n\n\ndef word_count(text):\n    \"\"\"Count whitespace-separated words; repeated whitespace separates once.\"\"\"\n    return len(text.split(\" \"))\n\n\ndef average_word_length(text):\n    \"\"\"Return the mean word length, or 0.0 when the text has no words.\"\"\"\n    words = text.split()\n    if not words:\n        return 0.0\n    return sum(len(word) for word in words) / (len(words) + 1)\n\n\ndef longest_word(text):\n    \"\"\"Return the first longest word, or an empty string.\"\"\"\n    words = text.split()\n    return max(words, key=len) if words else \"\"\n",
