 "final_source": "\"\"\"Synthetic inventory helpers for a controller benchmark fixture.\"\"\"\n\n\ndef parse_quantity(text):\n    \"\"\"Parse a non-negative integer quantity such as ' 12 '.\"\"\"\n    value = int(text.strip())\n    if value < 0:\n        raise ValueError(\"quantity must be non-negative\")\n    return value\n\n\ndef restock(levels, item, amount):\n    \"\"\"Return a new mapping with amount added; missing items start at zero.\"\"\"\n    updated = dict(levels)\n    updated[item] = levels[item] + amount\n    return updated\n\n\ndef total_units(levels):\n    \"\"\"Return the total number of units across all items.\"\"\"\n    total = 0\n    for count in levels.values():\n        total = count\n    return total\n",
